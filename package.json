{
  "name": "tutor",
  "version": "1.0.0",
  "description": "A web application to learn german",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npx tailwindcss -i ./styles.css -o ./dist/output.css && vite build --base=/tutor/",
    "preview": "vite preview",
    "css": "npx tailwindcss -i ./styles.css -o ./dist/output.css --watch",
    "serve": "vite --port 8002 --host 0.0.0.0",
    "static": "python -m http.server 8002",
    "debug": "vite --port 8002 --host 0.0.0.0 --debug",
    "clean": "rm -rf dist && mkdir -p dist"
  },
  "author": "Metaskepsis",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^4.5.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs": "^0.0.1-security",
    "http-proxy-middleware": "^3.0.3",
    "path": "^0.12.7"
  }
}
