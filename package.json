{
  "name": "tutor",
  "version": "1.0.0",
  "description": "A web application to learn german",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npx tailwindcss -i ./styles.css -o ./dist/output.css && vite build",
    "preview": "vite preview",
    "css": "npx tailwindcss -i ./styles.css -o ./dist/output.css --watch",
    "serve": "vite --port 8002 --host 0.0.0.0",
    "copy-js": "mkdir -p public/js && cp -r js/* public/js/",
    "debug": "vite --port 8002 --host 0.0.0.0 --debug"
  },
  "author": "Metaskepsis",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^4.5.3"
  },
  "dependencies": {
    "fs": "^0.0.1-security",
    "path": "^0.12.7"
  }
}
